---
import Base from '../layouts/Base.astro';

const career = [
  {
    role: 'IT Infrastructure and Operations Manager',
    org: 'City Cement Company, Riyadh',
    when: 'May 2025 – present',
    text: 'Accountable for IT strategy, operations and governance across a large industrial enterprise: ISO 27001 aligned security, tested disaster recovery, vendor and cost governance, and direct reporting to the C-suite.',
  },
  {
    role: 'Senior Network Specialist',
    org: 'Smith & Associates Europe BV, Netherlands',
    when: 'Jan 2025 – Apr 2025',
    text: 'Designed and deployed layered security controls and network architecture for a global enterprise, with documentation and disaster recovery validation.',
  },
  {
    role: 'IT Infrastructure Manager',
    org: 'City Cement Company, Riyadh',
    when: 'Jan 2017 – Dec 2024',
    text: 'Built the IT and cyber security policy framework from the ground up, delivered the SAP ERP program, led infrastructure modernisation and established disaster recovery.',
  },
  {
    role: 'Network Consulting Engineer',
    org: 'Cisco Systems, Dubai',
    when: 'Jul 2016 – Jan 2017',
    text: 'Designed ISP gateway networks and DNS and URL-filtering platforms for regional enterprise and telecom clients.',
  },
  {
    role: 'Manager Core Network (Data Center)',
    org: 'Punjab Information Technology Board, Lahore',
    when: 'Oct 2014 – Jun 2016',
    text: 'Designed and ran the data center for multiple provincial government agencies, including a zero-downtime migration of live production systems.',
  },
  {
    role: 'Senior Network Engineer',
    org: 'Getronics Pakistan; ADGLDI (Pvt) Ltd',
    when: '2009 – 2014',
    text: 'Pre-sales design and delivery of enterprise network, security and unified communications projects, then enterprise voice and data networks.',
  },
];

const projects = [
  { title: 'SAP ERP digital transformation', text: 'Owned the infrastructure foundation and full deployment lifecycle for SAP ERP at a major industrial company, delivered within scope and timeline.' },
  { title: 'IT and cyber security governance program', text: 'Designed and enforced a complete policy framework from scratch, and introduced a SharePoint-based e-signature approval system to modernise approvals.' },
  { title: 'Disaster recovery and business continuity', text: 'Designed, implemented and validated DR and BCP plans for critical ERP and production workloads, with tested failover and defined recovery targets.' },
  { title: 'Infrastructure modernisation', text: 'Led a multi-phase upgrade covering network re-architecture, security hardening, storage and server virtualisation, and a nationwide fiber cabling upgrade.' },
  { title: 'Multi-agency government data center', text: 'Engineered the full data center for multiple Punjab government agencies: Cisco Nexus fabric, firewall clusters, load balancing, compute and voice, in both production and DR.' },
  { title: 'Carrier and health-sector data centers', text: 'Designed a 10G top-of-rack data center for a national carrier, and built the datacenter behind a public Health Management Information System.' },
];

const events = [
  {
    year: '2026', name: 'SecTor', place: 'Toronto, Canada', when: 'October 2026',
    text: "Three things stuck with me: real exploitability matters more than a CVE's severity score; AI agents with access to systems should be secured like any user identity; and AI is replacing slow, manual workflows, not teams.",
    img: '/images/sector-2026.jpg', w: 900, h: 923, alt: 'Ghulam Abbas standing in front of the SecTor 2026 sign in Toronto',
    link: { href: '/blog/sector-2026-takeaways', label: 'Read my takeaways' },
  },
  {
    year: '2026', name: 'Cisco Live USA', place: 'Las Vegas, USA', when: '31 May – 4 June 2026',
    text: 'Back at the main Cisco event, this time wearing the CCIE Ten Years ribbon.',
    img: '/images/cisco-live-2026-badge.jpg', w: 800, h: 1212, alt: 'Cisco Live 2026 Las Vegas badge with CCIE and CCIE Ten Years ribbons',
  },
  {
    year: '2025', name: 'Cisco Live Melbourne', place: 'Melbourne, Australia', when: '10 – 13 November 2025',
    text: 'Connecting with the Cisco community in the Asia-Pacific region. As a CCIE with ten years of certification, I was recognised on the main screen at the event.',
    img: '/images/melbourne-2025-expo.jpg', w: 900, h: 675, alt: 'Ghulam Abbas walking down the blue carpet under the Cisco sign at Cisco Live Melbourne 2025',
  },
  {
    year: '2024', name: 'SecTor', place: 'Toronto, Canada', when: '22 – 24 October 2024',
    text: "Three days at the Metro Toronto Convention Centre with around 5,000 in-person attendees and 140+ security vendors. Keynotes came from Leigh Honeywell and Omkhar Arasaratnam, and the programme included the first AI Summit at SecTor alongside the Cloud Security and Executive summits.",
  },
  {
    year: '2024', name: 'Cisco Live USA', place: 'Las Vegas, USA', when: 'June 2024',
    text: 'Nine sessions across AI readiness, security operations with Cisco XDR and Splunk, Meraki Wi-Fi troubleshooting, zero-trust training and the Networking Innovation Summit, plus time at the Technical Assistance Center.',
    link: { href: '/blog/cisco-live-2024-lessons', label: 'What I took away' },
  },
];

const gallery = [
  { src: '/images/melbourne-2025-entrance.jpg', w: 700, h: 933, alt: 'Ghulam Abbas at the Cisco Live entrance hall in Melbourne', caption: 'At the entrance hall' },
  { src: '/images/melbourne-2025-auditorium.jpg', w: 700, h: 934, alt: 'Selfie of Ghulam Abbas in the Cisco Live main auditorium', caption: 'In the main auditorium' },
  { src: '/images/melbourne-2025-ccie-recognition.jpg', w: 900, h: 885, alt: 'CCIE recognition slide at Cisco Live Melbourne with the name Ghulam Abbas', caption: 'CCIE recognition, with my name on the big screen' },
  { src: '/images/cisco-live-melbourne-2025.jpg', w: 800, h: 1110, alt: 'Cisco Live Melbourne 2025 badge with CCIE and CCIE Ten Years ribbons', caption: 'My badge, with the CCIE Ten Years ribbon' },
];

const certs = [
  { group: 'Cisco', items: ['CCIE Data Center', 'CCNP Enterprise', 'CCNP Security', 'CCNA', 'Specialist badges: Data Center Core, Enterprise Core, Enterprise Advanced Infrastructure, Security Core, Network Security Firewalls'] },
  { group: 'Juniper', items: ['JNCIP-ENT', 'JNCIS-ER', 'JNCIA-ER'] },
  { group: 'Cloud', items: ['AWS Certified Solutions Architect – Associate', 'Microsoft Certified: Azure Administrator Associate', 'Microsoft Azure Architect Technologies'] },
  { group: 'Project and service management', items: ['Project Management Professional (PMP)', 'ITIL Foundation V3', 'SAP Certified Associate – SAP Activate Project Manager'] },
  { group: 'Application delivery', items: ['F5 Application Delivery Fundamentals'] },
  { group: 'Education', items: ['MBA, University of the Punjab', 'MSc Telecommunication, GC University Lahore'] },
];
---

<Base title="Work & Achievements" description="Career highlights, key projects and certifications of Ghulam Abbas: SAP ERP delivery, disaster recovery, data center design and cyber security governance.">
  <section class="section">
    <div class="wrap">
      <h1>Work &amp; achievements</h1>
      <p class="muted" style="max-width:60ch">
        The short version of 15+ years in IT infrastructure, security and operations. Each project below solved a real
        business problem, not just a technical one.
      </p>

      <h2>Key projects</h2>
      <div class="grid">
        {projects.map((p) => (
          <div class="card">
            <h3>{p.title}</h3>
            <p class="muted">{p.text}</p>
          </div>
        ))}
      </div>

      <h2>Career</h2>
      <ol class="timeline">
        {career.map((c) => (
          <li>
            <h3>{c.role}</h3>
            <p class="when">{c.org} · {c.when}</p>
            <p>{c.text}</p>
          </li>
        ))}
      </ol>

      <h2 id="milestone">Milestone: 10 years as a CCIE</h2>
      <div class="card feature">
        <img src="/images/ccie-10-years.jpg" alt="Cisco 10th anniversary CCIE plaque awarded to Ghulam Abbas" width="800" height="1068" loading="lazy" />
        <div>
          <p>
            In October 2025, Cisco marked ten years since I earned my CCIE in Data Center, the company's expert-level
            certification, first achieved in July 2015. It requires passing both a written exam and a hands-on lab
            exam, and I've kept it current ever since.
          </p>
          <p class="muted small">Cisco's note on the plaque: "Cisco salutes your dedication to excellence in the implementation and maintenance of the world's most sophisticated networks."</p>
        </div>
      </div>

      <h2 id="conferences">Conferences &amp; community</h2>
      <p class="muted" style="max-width:60ch">
        I make a point of attending the industry's main events in person. It keeps what I write grounded in how the
        technology is actually used today, and I bring the lessons back to this blog.
      </p>
      <div class="grid">
        {events.map((e) => (
          <div class="card">
            {e.img && <img src={e.img} alt={e.alt} width={e.w} height={e.h} loading="lazy" />}
            <div class="meta"><span class="tag">{e.year}</span><span>{e.place} · {e.when}</span></div>
            <h3 style="margin-top:6px">{e.name}</h3>
            <p class="muted">{e.text}</p>
            {e.link && <p><a href={e.link.href}>{e.link.label} →</a></p>}
          </div>
        ))}
      </div>

      <h3 style="margin-top:2.2em">Cisco Live Melbourne 2025 in photos</h3>
      <div class="gallery">
        {gallery.map((g) => (
          <figure>
            <img src={g.src} alt={g.alt} width={g.w} height={g.h} loading="lazy" />
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </div>

      <h2 id="certifications">Certifications and education</h2>
      <div class="cert-groups">
        {certs.map((c) => (
          <div class="card">
            <h3>{c.group}</h3>
            <ul>{c.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>
