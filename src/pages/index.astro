---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';
import { SITE, CATEGORIES } from '../config';

const posts = (await getCollection('blog', (p) => !p.data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">IT infrastructure · Cyber security · Career guidance</p>
      <h1>IT help that makes sense, from someone who has run it at scale.</h1>
      <p class="lead">
        I'm {SITE.owner}. I have spent 15+ years building and securing enterprise IT, from government data centers to
        industrial operations. Here I share what I've learned so you can fix problems faster, stay safer online, and grow
        your own IT career.
      </p>
      <div class="cta-row">
        <a class="btn" href="/blog">Read the blog</a>
        <a class="btn ghost" href="/about">About me</a>
      </div>
      <div class="stats">
        <div class="stat"><strong>15+</strong><span>years in enterprise IT</span></div>
        <div class="stat"><strong>10 yrs</strong><span>as a CCIE (Data Center)</span></div>
        <div class="stat"><strong>20+</strong><span>professional certifications</span></div>
        <div class="stat"><strong>PMP</strong><span>project leadership</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 style="margin-top:0">What you'll find here</h2>
      <div class="grid">
        {
          Object.entries(CATEGORIES).map(([key, c]) => (
            <a class="card" href={`/blog/category/${key}`}>
              <h3>{c.label}</h3>
              <p class="muted">{c.blurb}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="section-head">
        <h2 style="margin-top:0">Latest posts</h2>
        <a href="/blog">All posts →</a>
      </div>
      <PostList posts={posts} />
    </div>
  </section>
</Base>
