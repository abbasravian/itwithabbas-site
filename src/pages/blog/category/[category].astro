---
import Base from '../../../layouts/Base.astro';
import PostList from '../../../components/PostList.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '../../../config';

export function getStaticPaths() {
  return Object.keys(CATEGORIES).map((category) => ({ params: { category } }));
}

const { category } = Astro.params as { category: keyof typeof CATEGORIES };
const info = CATEGORIES[category];
const posts = (await getCollection('blog', (p) => !p.data.draft && p.data.category === category)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<Base title={info.label} description={info.blurb}>
  <section class="section">
    <div class="narrow">
      <h1>{info.label}</h1>
      <p class="muted">{info.blurb}</p>
      <nav class="filters" aria-label="Categories">
        <a href="/blog">All</a>
        {
          Object.entries(CATEGORIES).map(([key, c]) => (
            <a href={`/blog/category/${key}`} aria-current={key === category ? 'page' : undefined}>{c.label}</a>
          ))
        }
      </nav>
      {posts.length ? <PostList posts={posts} /> : <p class="muted">No posts in this category yet. Check back soon.</p>}
    </div>
  </section>
</Base>
